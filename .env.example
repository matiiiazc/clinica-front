# Plantilla de configuracion del front. Copiala a .env y ajustala.
#
#   copy .env.example .env
#
# A diferencia del back, acá NO hay secretos: Vite mete todo lo VITE_* dentro
# del bundle que ve el navegador. Por eso nunca pongas una clave real acá, ni
# aunque la variable se llame VITE_ algo de SECRET o KEY.
#
# Ojo: al cambiar VITE_PORT tenes que cambiar tambien en el .env del back
# CORS_ORIGINS, CSRF_TRUSTED_ORIGINS y FRONTEND_URL. Si no, el login y el
# registro se rejected con un error de CORS o de CSRF.

# Puerto del servidor de desarrollo de Vite.
# Si elDefault (5173) ya lo tiene otro proyecto, Vite prueba el siguiente
# libre solo. Fijalo con VITE_PORT=0 para forzar un puerto al azar.
VITE_PORT=5173

# A donde reenvia Vite /api y /health. Tiene que ser el Django.
VITE_API_TARGET=http://127.0.0.1:8000